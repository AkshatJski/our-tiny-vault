# ─────────────────────────────────────────────────────────────────────────────
# our tiny vault — environment template
# Copy to `.env.local` and fill in. Everything here is inside a FREE tier.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (free: 500MB DB, 1GB Storage, 200 concurrent realtime conns) ───
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose. Used by the daily cron to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Exact same string as the anon key: service role bypasses RLS by design.
# (kept separate so the cron can be the only consumer of the service key.)

# ── Email — configure ONE provider. Both are free, both send the same letter.
#    We self-cap at 90/day on either (see src/lib/budget.ts).
#
# Brevo (the $0 default): reaches any recipient, no domain required.
#   brevo.com → SMTP & API → "API keys" tab → create an API key v3 (xkeysib-…)
#   ⚠ NOT the "SMTP keys" tab. An SMTP key (xsmtpsib-…) is rejected by the HTTP
#     API with `401 Key not found`, so the app treats it as "not configured".
#   brevo.com → Senders → verify the address a link is sent to your inbox
BREVO_API_KEY=
# Accepts either `you@gmail.com` or `our tiny vault <you@gmail.com>`.
# Must be the exact address you verified above.
BREVO_FROM=
BREVO_FROM_NAME="our tiny vault"
#
# Resend (only worth it once you own a domain: the free tier delivers to the
# account owner's address and nobody else until a domain is verified).
RESEND_API_KEY=
RESEND_FROM="our tiny vault <hello@your-verified-domain.com>"
#
# Optional. Set to `brevo` or `resend` to pin the sender when both keys exist.
# Leave blank and the app uses whichever keys are present (Brevo wins).
EMAIL_PROVIDER=
# Hard failsafe, clamped to ≤ 90 in code so one retry can never overshoot.
EMAIL_DAILY_CAP=90

# ── Cron security ────────────────────────────────────────────────────────────
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` to cron routes.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CRON_SECRET=dev-secret

# ── Public app URL (the .vercel.app domain is free forever) ──────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── $0-budget knobs (see src/lib/budget.ts) ──────────────────────────────────
# Keep-alive heartbeat. The daily cron touches Supabase so the free project
# never hits the 7-day-inactivity auto-pause while a capsule is still sealed.
ENABLE_KEEPALIVE=true
# Weekly tiny JSON snapshot of capsule text, so the vault survives a bad day.
ENABLE_WEEKLY_BACKUP=false
# How many capsules one cron run is allowed to scan/unlock (cheap query guard).
CRON_MAX_CAPSULES_PER_RUN=25
