# ─────────────────────────────────────────────────────────────────────────────
# our tiny vault — environment template
# Copy to `.env.local` and fill in. Everything here is inside a FREE tier.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (free: 500MB DB, 1GB Storage, 200 concurrent realtime conns) ───
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose. Used by the daily cron to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Exact same string as the anon key: service role bypasses RLS by design.
# (kept separate so the cron can be the only consumer of the service key.)

# ── Resend (free: 100 emails/day — we self-cap at 90) ────────────────────────
RESEND_API_KEY=
# Must be a domain you verified on Resend. Use onboarding@resend.dev to test.
RESEND_FROM="our tiny vault <hello@your-verified-domain.com>"
# Hard failsafe. Vercel Hobby has no way to raise Resend's limit — so we stop first.
RESEND_DAILY_CAP=90

# ── Cron security ────────────────────────────────────────────────────────────
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` to cron routes.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CRON_SECRET=dev-secret

# ── Public app URL (the .vercel.app domain is free forever) ──────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── $0-budget knobs (see src/lib/budget.ts) ──────────────────────────────────
# Keep-alive heartbeat. The daily cron touches Supabase so the free project
# never hits the 7-day-inactivity auto-pause while a capsule is still sealed.
ENABLE_KEEPALIVE=true
# Weekly tiny JSON snapshot of capsule text, so the vault survives a bad day.
ENABLE_WEEKLY_BACKUP=false
# How many capsules one cron run is allowed to scan/unlock (cheap query guard).
CRON_MAX_CAPSULES_PER_RUN=25
